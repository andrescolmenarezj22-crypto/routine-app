{
  "name": "routine-app",
  "version": "1.0.0",
  "description": "App de rutinas personalizable con alarmas y recordatorios",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsc -b tsconfig.electron.json",
    "preview": "vite preview",
    "electron:dev": "vite build && tsc -b tsconfig.electron.json && electron .",
    "electron:build": "tsc -b && vite build && tsc -b tsconfig.electron.json && electron-builder --win --x64",
    "electron:build:portable": "tsc -b && vite build && tsc -b tsconfig.electron.json && electron-builder --win portable"
  },
  "build": {
    "appId": "com.routineapp.desktop",
    "productName": "RoutineApp",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/favicon.svg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "es"
      ]
    }
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "firebase": "^12.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
